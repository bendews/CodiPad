+Maybe<void> SetEnvironmentVariables(Environment* env,
+                                    Local<Context> context,
+                                    Local<Object> values) {
+  CHECK_NOT_NULL(env);
+  CHECK_EQ(context->GetIsolate(), env->isolate());
+
+  std::shared_ptr<KVStore> env_vars = KVStore::CreateMapKVStore();
+  if (env_vars->AssignFromObject(context, values).IsNothing()) {
+    return Nothing<void>();
+  }
+
+  env->set_env_vars(std::move(env_vars));
+  return JustVoid();
