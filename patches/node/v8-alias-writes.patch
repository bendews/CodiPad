+#if defined(V8_OS_IOS)
+extern "C" {
+extern uintptr_t codipad_v8_rx_begin;
+extern uintptr_t codipad_v8_rx_end;
+extern uintptr_t codipad_v8_rw_begin;
+}
+#endif
+
 namespace v8 {
 namespace base {
+
+// RX addresses remain canonical for PCs, relocations and object identity.
+// Only write destinations use the debugger-backed writable alias.
+V8_INLINE uintptr_t JitWriteAddress(uintptr_t address) {
+#if defined(V8_OS_IOS)
+  if (address >= codipad_v8_rx_begin && address < codipad_v8_rx_end)
+    return codipad_v8_rw_begin + (address - codipad_v8_rx_begin);
+#endif
+  return address;
+}
+
 
