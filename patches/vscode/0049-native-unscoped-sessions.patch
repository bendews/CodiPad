@@ -0,0 +1,20 @@
+/*---------------------------------------------------------------------------------------------
+ * Native embedders may have session providers without a discoverable remote agent host.
+ *--------------------------------------------------------------------------------------------*/
+import { IWorkbenchEnvironmentService } from '../../../../workbench/services/environment/common/environmentService.js';
+import { IChatSessionsService } from '../../../../workbench/contrib/chat/common/chatSessionsService.js';
+import { ISessionsProvidersService } from '../../../services/sessions/browser/sessionsProvidersService.js';
+import { isAgentHostProvider } from '../../../common/agentHostSessionsProvider.js';
+import { IChatEntitlementService } from '../../../../workbench/services/chat/common/chatEntitlementService.js';
+
+/** Only surface a real, visible creation provider backed by a registered content provider. */
+export function hasNativeUnscopedSessionProvider(environment: IWorkbenchEnvironmentService,
+ providers: ISessionsProvidersService, chats: IChatSessionsService, entitlement: IChatEntitlementService, providerId?: string): boolean {
+ if (!environment.supportsLocalNodeExtensionHost || entitlement.sentiment.hidden || entitlement.sentiment.disabled || entitlement.sentiment.disabledInWorkspace) { return false; }
+ const schemes = new Set(chats.getContentProviderSchemes());
+ return providers.getProviders().some(provider =>
+  (!providerId || provider.id === providerId) && provider.supportsWorkspaceSelection !== false &&
+  (!isAgentHostProvider(provider) || provider.isVisibleInEnvironmentPicker?.get() !== false) &&
+  provider.sessionTypes.some(type => schemes.has(type.chatSessionType ?? type.id)) &&
+  (provider.supportsLocalWorkspaces || provider.browseActions.some(action => !action.attachesContext)));
+}
