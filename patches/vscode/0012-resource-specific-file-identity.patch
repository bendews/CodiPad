+				return scheme === 'mixed' ? {
+					capabilities: FileSystemProviderCapabilities.PathCaseSensitive,
+					capabilitiesForResource: () => this.caseSensitive ? FileSystemProviderCapabilities.PathCaseSensitive : FileSystemProviderCapabilities.None,
+					onDidChangeCapabilities: Event.None
+				} as IFileSystemProvider : undefined;
+			}
+			override hasProvider(uri: URI): boolean {
+				return uri.scheme === 'mixed' || super.hasProvider(uri);
