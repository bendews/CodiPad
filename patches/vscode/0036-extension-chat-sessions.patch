+export function convertChatResult(result: vscode.ChatResult | void, extension: IExtensionDescription, participantId: string, logService: ILogService, timings?: IChatAgentResultTimings): IChatAgentResult {
+	if (result?.metadata) {
+		try {
+			JSON.stringify(result.metadata);
+		} catch (err) {
+			const msg = `result.metadata MUST be JSON.stringify-able. Got error: ${err.message}`;
+			logService.error(`[${extension.identifier.value}] [@${participantId}] ${msg}`, extension);
+			return { errorDetails: { message: msg }, timings, nextQuestion: result.nextQuestion, };
+		}
+	}
+	let errorDetails: IChatResponseErrorDetails | undefined;
+	if (result?.errorDetails) {
+		errorDetails = {
+			...result.errorDetails,
+			responseIsIncomplete: true
+		};
+	}
+	if (errorDetails?.responseIsRedacted || errorDetails?.isQuotaExceeded || errorDetails?.isRateLimited || errorDetails?.isExpectedError || errorDetails?.confirmationButtons || errorDetails?.code) {
+		checkProposedApiEnabled(extension, 'chatParticipantPrivate');
+	}
+
+	return { errorDetails, timings, metadata: result?.metadata, nextQuestion: result?.nextQuestion, details: result?.details } satisfies IChatAgentResult;
+}
