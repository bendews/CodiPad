+static bool sock_guest_signal_pending(void) {
+    if (current->sighand == NULL)
+        return false;
+    lock(&current->sighand->lock);
+    bool pending = !!(current->pending & ~current->blocked);
+    unlock(&current->sighand->lock);
+    return pending;
+}
+
+static bool sock_is_adopted_host(const struct fd *fd) {
+    return fd != NULL && fd->ops == &socket_fdops && fd->socket.adopted_host;
+}
 
