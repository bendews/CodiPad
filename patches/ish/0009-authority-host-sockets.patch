+static ssize_t sock_adopted_host_io(struct fd *fd, void *buf, size_t size, bool writing) {
+    if (size == 0)
+        return 0;
+    bool nonblock = (fd->flags & O_NONBLOCK_) != 0;
+    for (;;) {
+        ssize_t result;
+        if (writing) {
+            int flags = MSG_DONTWAIT;
+#ifdef MSG_NOSIGNAL
+            flags |= MSG_NOSIGNAL;
+#endif
+            result = send(fd->real_fd, buf, size, flags);
+        } else {
+            result = recv(fd->real_fd, buf, size, MSG_DONTWAIT);
+        }
+        if (result >= 0)
+            return result;
+        if (errno == EINTR) {
+            if (sock_guest_signal_pending())
+                return _EINTR;
+            continue;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+            int saved_errno = errno;
+            if (writing && saved_errno == EPIPE)
+                send_signal(current, SIGPIPE_, SIGINFO_NIL);
+            errno = saved_errno;
+            int error = errno_map();
+            sock_translate_err(fd, &error);
+            return error;
+        }
+        if (nonblock)
+            return _EAGAIN;
+        int wait_result = sock_wait_for(fd->real_fd, writing ? POLLOUT : POLLIN,
+                                        writing ? SO_SNDTIMEO : SO_RCVTIMEO);
+        if (wait_result < 0)
+            return wait_result;
+    }
+}
+
+static int sock_getflags(struct fd *fd) {
+    return sock_is_adopted_host(fd) ? fd->flags : realfs_getflags(fd);
+}
+
+static int sock_setflags(struct fd *fd, dword_t flags) {
+    if (!sock_is_adopted_host(fd))
+        return realfs_setflags(fd, flags);
+    // F_SETFL changes only guest-visible state for a borrowed socket; its host OFD is untouched.
+    const unsigned allowed = O_NONBLOCK_ | O_APPEND_;
+    fd->flags = (fd->flags & ~allowed) | (flags & allowed);
+    return 0;
+}
+
 const struct fd_ops socket_fdops = {
     .read = sock_read,
     .write = sock_write,
     .close = sock_close,
     .poll = realfs_poll,
-    .getflags = realfs_getflags,
-    .setflags = realfs_setflags,
+    .getflags = sock_getflags,
+    .setflags = sock_setflags,
     .ioctl_size = realfs_ioctl_size,
