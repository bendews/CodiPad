+static bool region_alloc_split(size_t hot_bytes, size_t cold_bytes,
+                               uint8_t **hot, uint8_t **cold) {
+    size_t h = (hot_bytes + 15) & ~(size_t) 15;
+    size_t c = (cold_bytes + 15) & ~(size_t) 15;
+    if (h + c > COLD_CHUNK) return false;
+    pthread_mutex_lock(&cold_lock);
+    if (!cold_chunk || h + c > cold_end - cold_hot) {
+        cold_chunk = region_alloc(COLD_CHUNK);
+        cold_hot = 0;
+        cold_end = COLD_CHUNK;
+    }
+    if (!cold_chunk) { pthread_mutex_unlock(&cold_lock); return false; }
+    *hot = cold_chunk + cold_hot;
+    cold_hot += h;
+    cold_end -= c;
+    *cold = cold_chunk + cold_end;
+    pthread_mutex_unlock(&cold_lock);
+    return true;
+}
