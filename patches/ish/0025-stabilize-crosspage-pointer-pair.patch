+// Translation can drop/reacquire the memory read lock for CoW, lazy commit
+// or stack growth. Both pointers must belong to the same mapping generation
+// before either is dereferenced; the caller still holds that read lock.
+static __no_instrument bool tlb_pointer_pair(struct tlb *tlb, addr_t first, addr_t second,
+                                             int type, char **out_first, char **out_second) {
+    for (;;) {
+        char *ptr1 = type == MEM_WRITE ? __tlb_write_ptr(tlb, first) : __tlb_read_ptr(tlb, first);
+        if (ptr1 == NULL)
+            return false;
+        uint64_t generation = __atomic_load_n(&tlb->mmu->changes, __ATOMIC_ACQUIRE);
+        char *ptr2 = type == MEM_WRITE ? __tlb_write_ptr(tlb, second) : __tlb_read_ptr(tlb, second);
+        if (ptr2 == NULL)
+            return false;
+        if (__atomic_load_n(&tlb->mmu->changes, __ATOMIC_ACQUIRE) == generation) {
+            *out_first = ptr1;
+            *out_second = ptr2;
+            return true;
+        }
+    }
+}
