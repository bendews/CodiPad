+// PTEs keep borrowed buffers alive under the address-space lock. Flat aliases
+// add an explicit reference until revocation succeeds. Counts span forked spaces.
+static void data_retain(struct data *data, size_t offset) {
+    atomic_fetch_add_explicit(&data->refcount, 1, memory_order_relaxed);
+    if (data->host_refs)
+        atomic_fetch_add_explicit(&data->host_refs[offset / real_page_size], 1, memory_order_relaxed);
+}
+
+static void data_release(struct data *data, size_t offset) {
+    if (data->host_refs) {
+        size_t group = offset / real_page_size;
+        unsigned previous = atomic_fetch_sub_explicit(&data->host_refs[group], 1, memory_order_acq_rel);
+        assert(previous != 0);
+        if (previous == 1 && atomic_load_explicit(&data->refcount, memory_order_relaxed) != 1) {
+            // No mapping or alias reaches this host page. Drop its physical
+            // backing but reserve its address until the allocation is freed.
+            // Failure only retains unused memory; it cannot fail guest unmap.
+            void *address = (char *) data->data + group * real_page_size;
+            (void) mmap(address, real_page_size, PROT_NONE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, 0, 0);
+        }
+    }
+    if (atomic_fetch_sub_explicit(&data->refcount, 1, memory_order_acq_rel) != 1)
+        return;
+    if (data->data != vdso_data) munmap(data->data, data->size);
+    if (data->fd != NULL) fd_close(data->fd);
+    free(data->host_refs);
+    free(data);
+}
