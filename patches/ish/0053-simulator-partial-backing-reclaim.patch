+// Whole-allocation unmap already releases backing in one munmap. Avoid
+// splitting it into host-page reservations first. The writer lock excludes
+// new local PTE/alias references; the exact count rules out other address spaces.
+static void data_unmap_whole(struct mem *mem, page_t start, pages_t remaining,
+                             struct data *data) {
+    if (!data->host_refs || data->size % PAGE_SIZE) return;
+    pages_t pages = data->size / PAGE_SIZE;
+    if (pages > remaining || atomic_load_explicit(&data->refcount, memory_order_acquire) != pages) return;
+    for (pages_t i = 0; i < pages; i++) {
+        struct pt_entry *pt = mem_pt(mem, start + i);
+        if (!pt || pt->data != data || pt->offset != i * PAGE_SIZE) return;
+    }
+    free(data->host_refs);
+    data->host_refs = NULL;
+}
