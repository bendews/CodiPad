+// A host signal can be handled before read enters the kernel. Keep re-kicking
+// only a pending guest signal until the registered FIFO read has returned.
+// No file-description flags change, and positive/partial read results stay intact.
+struct realfs_read_wait {
+    struct task *task;
+    pthread_t thread;
+    struct realfs_read_wait *next;
+};
+static pthread_mutex_t realfs_read_wait_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t realfs_read_wait_changed = PTHREAD_COND_INITIALIZER;
+static struct realfs_read_wait *realfs_read_waits;
+static bool realfs_read_wait_started;
+
+static bool realfs_read_signal_pending(struct task *task) {
+    if (task == NULL || task->sighand == NULL)
+        return false;
+    lock(&task->sighand->lock);
+    bool pending = !!(task->pending & ~task->blocked);
+    unlock(&task->sighand->lock);
+    return pending;
+}
+
+static void *realfs_read_wait_watch(void *unused) {
+    (void) unused;
+    pthread_mutex_lock(&realfs_read_wait_lock);
+    for (;;) {
+        while (realfs_read_waits == NULL)
+            pthread_cond_wait(&realfs_read_wait_changed, &realfs_read_wait_lock);
+        for (struct realfs_read_wait *wait = realfs_read_waits; wait; wait = wait->next) {
+            if (realfs_read_signal_pending(wait->task))
+                pthread_kill(wait->thread, SIGUSR1);
+        }
+        // The lock spans each kick and unregister, so a returned read has no
+        // remaining task reference or later kick call. Empty service waits are idle.
+        struct timespec delay = {.tv_sec = 0, .tv_nsec = 100000000};
+#if __APPLE__
+        pthread_cond_timedwait_relative_np(&realfs_read_wait_changed, &realfs_read_wait_lock, &delay);
+#else
+        struct timespec deadline;
+        clock_gettime(CLOCK_REALTIME, &deadline);
+        deadline.tv_nsec += delay.tv_nsec;
+        if (deadline.tv_nsec >= 1000000000) {
+            deadline.tv_nsec -= 1000000000;
+            deadline.tv_sec++;
+        }
+        pthread_cond_timedwait(&realfs_read_wait_changed, &realfs_read_wait_lock, &deadline);
+#endif
+    }
+}
+
+static int realfs_read_wait_begin(struct realfs_read_wait *wait) {
+    pthread_mutex_lock(&realfs_read_wait_lock);
+    if (!realfs_read_wait_started) {
+        pthread_attr_t attributes;
+        int err = pthread_attr_init(&attributes);
+        if (err == 0) {
+            err = pthread_attr_setdetachstate(&attributes, PTHREAD_CREATE_DETACHED);
+            if (err == 0) {
+                pthread_t thread;
+                err = pthread_create(&thread, &attributes, realfs_read_wait_watch, NULL);
+            }
+            pthread_attr_destroy(&attributes);
+        }
+        if (err != 0) {
+            pthread_mutex_unlock(&realfs_read_wait_lock);
+            errno = err;
+            return errno_map();
+        }
+        realfs_read_wait_started = true;
+    }
+    wait->next = realfs_read_waits;
+    realfs_read_waits = wait;
+    pthread_cond_signal(&realfs_read_wait_changed);
+    pthread_mutex_unlock(&realfs_read_wait_lock);
+    return 0;
+}
+
+static void realfs_read_wait_end(void *data) {
+    struct realfs_read_wait *wait = data;
+    pthread_mutex_lock(&realfs_read_wait_lock);
+    struct realfs_read_wait **link = &realfs_read_waits;
+    while (*link != wait)
+        link = &(*link)->next;
+    *link = wait->next;
+    pthread_cond_signal(&realfs_read_wait_changed);
+    pthread_mutex_unlock(&realfs_read_wait_lock);
+}
+
+#ifdef REALFS_READ_WAIT_TESTING
+// Read-only private probe observation; not present in app archives.
+void realfs_read_wait_test_snapshot(unsigned *registrations, unsigned *helpers) {
+    pthread_mutex_lock(&realfs_read_wait_lock);
+    unsigned count = 0;
+    for (struct realfs_read_wait *wait = realfs_read_waits; wait; wait = wait->next)
+        count++;
+    *registrations = count;
+    *helpers = realfs_read_wait_started ? 1 : 0;
+    pthread_mutex_unlock(&realfs_read_wait_lock);
+}
+#endif
+
+static ssize_t realfs_read_interruptible(struct fd *fd, void *buf, size_t bufsize) {
+    for (;;) {
+        if (bufsize != 0 && realfs_read_signal_pending(current))
+            return _EINTR;
+        ssize_t res = read(fd->real_fd, buf, bufsize);
+        if (res >= 0)
+            return res;
+        if (errno != EINTR)
+            return errno_map();
+    }
+}
+
 ssize_t realfs_read(struct fd *fd, void *buf, size_t bufsize) {
