-        res = read(fd->real_fd, buf, bufsize);
-    } while (res < 0 && errno == EINTR);
-    if (res < 0)
-        return errno_map();
-    return res;
+    if (current == NULL || current->sighand == NULL || !S_ISFIFO(fd->type) || bufsize == 0)
+        return realfs_read_interruptible(fd, buf, bufsize);
+    struct realfs_read_wait wait = {.task = current, .thread = pthread_self()};
+    int err = realfs_read_wait_begin(&wait);
+    if (err < 0)
+        return err;
+    ssize_t result;
+    pthread_cleanup_push(realfs_read_wait_end, &wait);
+    result = realfs_read_interruptible(fd, buf, bufsize);
+    pthread_cleanup_pop(1);
+    return result;
 }
 
