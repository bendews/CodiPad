+// Return the exact cache size selected by the engine's existing environment
+// and device-memory policy. Zero means startup has begun or this build cannot
+// emit translated code.
+size_t ish_jit_region_capacity(void) {
+#ifndef ISH_JIT_NO_EMIT
+    pthread_mutex_lock(&jit_region_lock);
+    if (jit_startup_started) {
+        pthread_mutex_unlock(&jit_region_lock);
+        return 0;
+    }
+    jit_cache_size();
+    size_t capacity = region_size;
+    pthread_mutex_unlock(&jit_region_lock);
+    return capacity;
+#else
+    return 0;
+#endif
+}
+
+// Install a cache lease from CodiPad's shared Node/JIT executable pool. The
+// owner already established RX and RW aliases; this never maps or chmods pages.
+bool ish_jit_install_region(void *rx, void *rw, size_t capacity) {
+#ifndef ISH_JIT_NO_EMIT
+    pthread_mutex_lock(&jit_region_lock);
+    if (jit_startup_started || region != NULL || rx == NULL || rw == NULL || rx == rw || capacity == 0 ||
+        ((uintptr_t) rx & 0x3fff) != 0 || ((uintptr_t) rw & 0x3fff) != 0 ||
+        capacity > UINTPTR_MAX - (uintptr_t) rx || capacity > UINTPTR_MAX - (uintptr_t) rw) {
+        pthread_mutex_unlock(&jit_region_lock);
+        return false;
+    }
+    jit_cache_size();
+    if (capacity != region_size) {
+        pthread_mutex_unlock(&jit_region_lock);
+        return false;
+    }
+    uintptr_t distance = (uintptr_t) rx > (uintptr_t) rw
+                             ? (uintptr_t) rx - (uintptr_t) rw
+                             : (uintptr_t) rw - (uintptr_t) rx;
+    if (distance + capacity >= (1ull << 32)) {
+        pthread_mutex_unlock(&jit_region_lock);
+        return false;
+    }
+    region = (uint8_t *) rx;
+    rw_delta = (intptr_t) rw - (intptr_t) rx;
+    dual_map = true;
+    jit_note("jit: shared executable cache installed");
+    pthread_mutex_unlock(&jit_region_lock);
+    return true;
+#else
+    return false;
+#endif
+}
