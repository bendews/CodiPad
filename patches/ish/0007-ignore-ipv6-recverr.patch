diff --git a/fs/sock.h b/fs/sock.h
--- a/fs/sock.h
+++ b/fs/sock.h
@@ -239,6 +239,7 @@
 #define TCP_CONGESTION_ 13
 #define IPV6_UNICAST_HOPS_ 16
 #define IPV6_V6ONLY_ 26
+#define IPV6_RECVERR_ 25
 #define IPV6_TCLASS_ 67
 #define ICMP6_FILTER_ 1
 
@@ -282,6 +283,9 @@ static inline int sock_opt_to_real(int fake, int level) {
         } break;
         case IPPROTO_IPV6: switch (fake) {
             case IPV6_UNICAST_HOPS_: return IPV6_UNICAST_HOPS;
+            // Darwin has no IPv6 ICMP error queue. glibc 2.36-9+deb12u14
+            // resolv/res_enable_icmp.c sets this; resolv/res_send.c treats failure as fatal.
+            case IPV6_RECVERR_: return 0;
             case IPV6_TCLASS_: return IPV6_TCLASS;
             case IPV6_V6ONLY_: return IPV6_V6ONLY;
         } break;
