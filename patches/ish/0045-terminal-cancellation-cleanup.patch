+// pids_lock pins sighand against the group-exit safety valve.
+void task_close_host_io(struct task *task) {
+    if (task->host_io_pipe[0] < 0 && task->host_io_pipe[1] < 0) return;
+    struct sighand *sighand = task->sighand;
+    if (sighand != NULL) lock(&sighand->lock);
+    for (unsigned i = 0; i < 2; i++) {
+        if (task->host_io_pipe[i] >= 0) close(task->host_io_pipe[i]);
+        task->host_io_pipe[i] = -1;
+    }
+    if (sighand != NULL) unlock(&sighand->lock);
+}
+
 void task_destroy(struct task *task) {
+    task_close_host_io(task);
     list_remove(&task->siblings);
     pid_get(task->pid)->task = NULL;
 
