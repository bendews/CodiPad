--- a/asbestos/guest-arm64/jit.c
+++ b/asbestos/guest-arm64/jit.c
@@ -3985,10 +3985,34 @@
 // sets ISH_JIT=0 for the gadget engine. Called on one thread, before the guest boots.
 static pthread_mutex_t jit_region_lock = PTHREAD_MUTEX_INITIALIZER;
 static bool jit_startup_started;
+static bool jit_mode_frozen;
+static bool jit_gadget_only;
 
+// All region installation and startup decisions share this lock.
+bool ish_jit_configure_mode(bool gadget_only) {
+    pthread_mutex_lock(&jit_region_lock);
+    bool ok = gadget_only == jit_gadget_only ||
+              (!jit_mode_frozen && !jit_startup_started && region == NULL);
+    if (ok) {
+        jit_gadget_only = gadget_only;
+    }
+    pthread_mutex_unlock(&jit_region_lock);
+    return ok;
+}
+
+void ish_jit_freeze_mode(void) {
+    pthread_mutex_lock(&jit_region_lock);
+    jit_mode_frozen = true;
+    pthread_mutex_unlock(&jit_region_lock);
+}
+
 bool ish_jit_try_enable(void) {
 #ifndef ISH_JIT_NO_EMIT
     pthread_mutex_lock(&jit_region_lock);
+    if (jit_gadget_only) {
+        pthread_mutex_unlock(&jit_region_lock);
+        return false;
+    }
     if (jit_startup_started) {
         bool enabled = region != NULL;
         pthread_mutex_unlock(&jit_region_lock);
@@ -4033,7 +4057,7 @@
