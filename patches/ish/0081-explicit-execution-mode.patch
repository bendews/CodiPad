         ((uintptr_t) rx & 0x3fff) != 0 || ((uintptr_t) rw & 0x3fff) != 0 ||
         capacity > UINTPTR_MAX - (uintptr_t) rx || capacity > UINTPTR_MAX - (uintptr_t) rw) {
         pthread_mutex_unlock(&jit_region_lock);
