+static int unix_accept_peer(struct fd *sock) {
+    uint64_t token;
+    int err = unix_handshake_io(sock, &token, sizeof(token), false);
+    if (err < 0)
+        return err;
+    fill_cred(&sock->socket.unix_cred);
+    err = _ECONNABORTED;
+    lock(&peer_lock);
+    struct unix_pending_connect *pending;
+    list_for_each_entry(&unix_pending_connections, pending, links) {
+        if (pending->token != token)
+            continue;
+        if (pending->acknowledged)
+            break;
+        // The connector owns both private pipe ends until it unregisters under this lock.
+        uint8_t ack = 0xa5;
+        ssize_t sent = write(pending->ack_pipe[1], &ack, sizeof(ack));
+        if (sent != sizeof(ack)) {
+            err = sent < 0 ? errno_map() : _ECONNRESET;
+            break;
+        }
+        pending->acknowledged = true;
+        struct fd *peer = pending->sock;
+        sock->socket.unix_peer = peer;
+        peer->socket.unix_peer = sock;
+        err = 0;
+        break;
+    }
+    unlock(&peer_lock);
+    return err;
+}
