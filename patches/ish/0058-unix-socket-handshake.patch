+// Transfer only protocol bytes; readiness and cancellation share the task wake pipe.
+static int unix_handshake_io(struct fd *sock, void *bytes, size_t length, bool writing) {
+    size_t offset = 0;
+    while (offset < length) {
+        int ready = task_wait_host_fd(sock->real_fd, writing ? POLLOUT : POLLIN, -1);
+        if (ready < 0)
+            return ready;
+        int flags = MSG_DONTWAIT;
+#ifdef MSG_NOSIGNAL
+        if (writing)
+            flags |= MSG_NOSIGNAL;
+#endif
+        ssize_t done = writing
+            ? send(sock->real_fd, (char *) bytes + offset, length - offset, flags)
+            : recv(sock->real_fd, (char *) bytes + offset, length - offset, flags);
+        if (done == 0)
+            return _ECONNRESET;
+        if (done < 0) {
+            if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)
+                continue;
+            return errno_map();
+        }
+        offset += done;
+    }
+    return 0;
+}
