+static int unix_connect_peer(struct fd *sock) {
+    struct unix_pending_connect pending = {.sock = sock};
+    int err = 0;
+    if (pipe(pending.ack_pipe) < 0) {
+        err = errno_map();
+        shutdown(sock->real_fd, SHUT_RDWR);
+        return err;
+    }
+    for (unsigned i = 0; i < 2; i++) {
+        if (fcntl(pending.ack_pipe[i], F_SETFL, O_NONBLOCK) < 0 ||
+                fcntl(pending.ack_pipe[i], F_SETFD, FD_CLOEXEC) < 0) {
+            err = errno_map();
+            goto close_ack;
+        }
+    }
+    fill_cred(&sock->socket.unix_cred);
+    lock(&peer_lock);
+    if (unix_next_connect_token == UINT64_MAX) {
+        unlock(&peer_lock);
+        err = _EOVERFLOW;
+        goto close_ack;
+    }
+    pending.token = unix_next_connect_token++;
+    list_add_tail(&unix_pending_connections, &pending.links);
+    unlock(&peer_lock);
+
+    err = unix_handshake_io(sock, &pending.token, sizeof(pending.token), true);
+    while (err == 0) {
+        // ACK is private; a concurrent guest recv must never see protocol bytes.
+        struct pollfd descriptors[2] = {
+            {.fd = sock->real_fd, .events = POLLIN}, // EOF; accepted guest output follows ACK
+            {.fd = pending.ack_pipe[0], .events = POLLIN},
+        };
+        err = task_wait_host_fds(descriptors, 2, -1);
+        if (err < 0)
+            break;
+        lock(&peer_lock);
+        err = 0;
+        if (pending.acknowledged) {
+            unlock(&peer_lock);
+            break;
+        }
+        if (descriptors[0].revents) {
+            // Keep ACK publication ordered with this nonblocking peek; it may enable guest writes.
+            char byte;
+            ssize_t n = recv(sock->real_fd, &byte, 1, MSG_PEEK | MSG_DONTWAIT);
+            if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
+                unlock(&peer_lock);
+                continue;
+            }
+            err = n < 0 ? errno_map() : n == 0 ? _ECONNRESET : _ECONNABORTED;
+            unlock(&peer_lock);
+            break;
+        }
+        unlock(&peer_lock);
+    }
+    lock(&peer_lock);
+    list_remove(&pending.links);
+    unlock(&peer_lock);
+close_ack:
+    close(pending.ack_pipe[0]);
+    close(pending.ack_pipe[1]);
+    if (err < 0)
+        shutdown(sock->real_fd, SHUT_RDWR); // a partial token must not strand the acceptor
+    return err;
+}
