+        return errno_map();
+    size_t length = strlen(root_path);
+    if (strncmp(current_path, root_path, length) != 0 ||
+        (length > 1 && current_path[length] != '/'))
+        return _EXDEV;
+    const char *relative = length == 1 ? current_path : current_path + length;
+    if (relative[0] != '/' || relative[1] == '\0')
