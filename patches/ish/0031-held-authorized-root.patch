+// Map against the live held root, never the source label or global bind-mount substitutions.
+static int realfs_getpath_held(struct fd *fd, char *buf) {
+    struct stat root, current, reachable;
+    if (fstat(fd->mount->root_fd, &root) < 0 || fstat(fd->real_fd, &current) < 0)
+        return errno_map();
+    if (root.st_dev == current.st_dev && root.st_ino == current.st_ino) {
