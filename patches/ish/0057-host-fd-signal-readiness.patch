--- a/kernel/task.c
+++ b/kernel/task.c
@@ -3,6 +3,8 @@
 #include "asbestos/guest-arm64/jit.h"
 #endif
 #include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
 #include <pthread.h>
 #include <stdlib.h>
 #include <string.h>
@@ -148,6 +150,98 @@
         deferred_free_list[i] = NULL;
     }
     deferred_free_count = 0;
+}
+
+// Only the owning guest thread initializes this pipe. Signal delivery uses
+// sighand->lock; publication and teardown additionally hold pids_lock.
+static int task_open_host_io(void) {
+    if (current->host_io_pipe[0] >= 0)
+        return 0;
+    int descriptors[2];
+    if (pipe(descriptors))
+        return errno_map();
+    for (unsigned i = 0; i < 2; i++) {
+        if (fcntl(descriptors[i], F_SETFL, O_NONBLOCK) < 0 ||
+                fcntl(descriptors[i], F_SETFD, FD_CLOEXEC) < 0) {
+            int error = errno_map();
+            close(descriptors[0]);
+            close(descriptors[1]);
+            return error;
+        }
+    }
+    lock(&pids_lock);
+    if (current->exiting || current->sighand == NULL) {
+        unlock(&pids_lock);
+        close(descriptors[0]);
+        close(descriptors[1]);
+        return _EINTR;
+    }
+    lock(&current->sighand->lock);
+    current->host_io_pipe[0] = descriptors[0];
+    current->host_io_pipe[1] = descriptors[1];
+    unlock(&current->sighand->lock);
+    unlock(&pids_lock);
+    return 0;
+}
+
+static int64_t task_host_now_ms(void) {
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (int64_t) now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+int task_wait_host_fd(int real_fd, short events, int timeout_ms) {
+    bool nonblocking = timeout_ms == 0;
+    int64_t deadline = timeout_ms > 0 ? task_host_now_ms() + timeout_ms : 0;
+    int error = nonblocking ? 0 : task_open_host_io();
+    if (error)
+        return error;
+    for (;;) {
+        lock(&pids_lock);
+        if (current->exiting || current->sighand == NULL) {
+            unlock(&pids_lock);
+            return _EINTR;
+        }
+        lock(&current->sighand->lock);
+        bool interrupted = (current->pending & ~current->blocked) != 0;
+        if (!interrupted && !nonblocking) {
+            char bytes[64];
+            while (read(current->host_io_pipe[0], bytes, sizeof(bytes)) > 0) {}
+        }
+        int wake_fd = current->host_io_pipe[0];
+        unlock(&current->sighand->lock);
+        unlock(&pids_lock);
+        if (interrupted)
+            return _EINTR;
+        int remaining = timeout_ms;
+        if (deadline != 0) {
+            int64_t left = deadline - task_host_now_ms();
+            if (left <= 0)
+                return 0;
+            remaining = (int) left;
+        }
+        struct pollfd descriptors[2] = {
+            {.fd = real_fd, .events = events},
+            {.fd = wake_fd, .events = POLLIN},
+        };
+        // Live guest threads retain their task and wake pipe through host return.
+        bool was_blocking = current->blocking;
+        current->blocking = !nonblocking;
+        int ready = poll(descriptors, nonblocking ? 1 : 2, remaining);
+        int saved_errno = errno;
+        current->blocking = was_blocking;
+        if (ready < 0) {
+            if (saved_errno == EINTR)
+                continue;
+            errno = saved_errno;
+            return errno_map();
+        }
+        if (ready == 0)
+            return 0;
+        if (!nonblocking && descriptors[1].revents)
+            continue;
+        return ready;
+    }
 }
 
