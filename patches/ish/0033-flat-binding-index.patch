+// Two-level sparse index: one slot per 4 KiB guest page, allocated on demand.
+// Entries are indexed by group start, so larger host pages leave holes.
+#define FLAT_INDEX_BITS 10
+#define FLAT_INDEX_SIZE (1u << FLAT_INDEX_BITS)
+
+static struct flat_memory_binding **flat_binding_link(struct mem *mem, page_t group, bool create) {
+    size_t high = group >> FLAT_INDEX_BITS, low = group & (FLAT_INDEX_SIZE - 1);
+    if (high >= FLAT_INDEX_SIZE) return NULL;
+    if (mem->flat_bindings == NULL && create)
+        mem->flat_bindings = calloc(FLAT_INDEX_SIZE, sizeof(*mem->flat_bindings));
+    if (mem->flat_bindings == NULL) return NULL;
+    if (mem->flat_bindings[high] == NULL && create)
+        mem->flat_bindings[high] = calloc(FLAT_INDEX_SIZE, sizeof(**mem->flat_bindings));
+    return mem->flat_bindings[high] ? &mem->flat_bindings[high][low] : NULL;
+}
