+// NODE_OPTIONS is parsed before command-line flags, so an injected CLI heap
+// limit would override a limit explicitly chosen in the environment.
+static bool node_options_has_heap_limit(const char *options) {
+    const char *names[] = {"--max-old-space-size", "--max-old-space-size-percentage", "--max-heap-size"};
+    bool matched = false, quoted = false;
+    char token[64];
+    size_t len = 0;
+    for (;;) {
+        char c = *options++;
+        if (c == '\\' && quoted) {
+            if (*options == '\0') return false;
+            c = *options++;
+        } else if (c == '"') {
+            quoted = !quoted;
+            continue;
+        } else if (c == '\0' || (c == ' ' && !quoted)) {
+            size_t n = len < sizeof(token) - 1 ? len : sizeof(token) - 1;
+            token[n] = '\0';
+            for (size_t i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+                size_t prefix = strlen(names[i]);
+                if (strncmp(token, names[i], prefix) == 0 &&
+                    (token[prefix] == '=' || (token[prefix] == '\0' && len == prefix)))
+                    matched = true;
+            }
+            len = 0;
+            if (c == '\0') return !quoted && matched;
+            continue;
+        }
+        if (len < sizeof(token) - 1) token[len] = c == '_' ? '-' : c;
+        len++;
+    }
+}
+#endif
 
