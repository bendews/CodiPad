+// ---------------------------------------------------------------- JIT fast mode (M11)
+//
+// A sideloaded app cannot make memory executable by itself: on TXM (iOS 26+) only pages a debugger
+// wrote become executable, and StikDebug's universal.js supplies them -- `brk #0xf00d` with x16 = 1
+// and x1 = the size asks debugserver for an RX region in this process (address back in x0), x16 = 0
+// detaches. The app asks StikDebug for that through its URL scheme before boot, then calls
+// ish_jit_try_enable(); the waiting is the app's, so nothing here loops. A failure is a journal
+// line and the gadget engine, never a crash.
+
+static void jit_note(const char *msg) {
+    fprintf(stderr, "ish: %s\n", msg);
+}
+
+#ifndef ISH_JIT_NO_EMIT   // an AOT-only build never maps executable memory
+// An RX region -> an RW alias of it (map_dual's two calls), so the emitter writes via rw_delta.
+static bool jit_region_from(uint8_t *rx, const char *ok_note) {
+    vm_address_t rw = 0;
+    vm_prot_t cur, max;
+    // universal.js answers an error with 0xE0000069; a misaligned or absurd address is no region.
+    bool ok = rx != NULL && ((uintptr_t) rx & 0x3fff) == 0 && (uintptr_t) rx != 0xE0000069 &&
+              (uintptr_t) rx < 0x1000000000ull &&
+              vm_remap(mach_task_self(), &rw, region_size, 0, VM_FLAGS_ANYWHERE, mach_task_self(),
+                       (vm_address_t) rx, false, &cur, &max, VM_INHERIT_NONE) == KERN_SUCCESS &&
+              mprotect((void *) rw, region_size, PROT_READ | PROT_WRITE) == 0;
+    if (!ok) {
+        jit_note("jit: fallback (debugger region unusable)");
+        return false;
+    }
+    region = rx;
+    rw_delta = (intptr_t) rw - (intptr_t) rx;
+    dual_map = true;
+    jit_note(ok_note);
+    return true;
