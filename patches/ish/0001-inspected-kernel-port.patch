+// the attached debugger does not answer is a fatal SIGTRAP.
+__attribute__((naked, noinline)) static void *jit_brk_region(void *addr, size_t size) {
+    __asm__("mov x16, #1\n brk #0xf00d\n ret");
+}
+__attribute__((naked, noinline)) static void jit_brk_detach(void) {
+    __asm__("mov x16, #0\n brk #0xf00d\n ret");
+}
