+// Limit the cache after the debugger supplies a smaller shared pool. This is
+// only legal before the translator has borrowed or started using a mapping.
+bool ish_jit_limit_region_capacity(size_t maximum) {
+#ifndef ISH_JIT_NO_EMIT
+    pthread_mutex_lock(&jit_region_lock);
+    bool ok = !jit_startup_started && region == NULL && maximum >= (16u << 20) &&
+              maximum <= ((size_t) 1024 << 20) && !(maximum & (maximum - 1));
+    if (ok) region_maximum = maximum;
+    pthread_mutex_unlock(&jit_region_lock);
+    return ok;
+#else
+    return false;
+#endif
+}
