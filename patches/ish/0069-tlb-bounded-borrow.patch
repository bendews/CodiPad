     }
@@ -261,6 +270,17 @@
     }
 
     tlb->dirty_page = TLB_PAGE(addr);
+
+    if (uncached) {
+        unsigned index = TLB_INDEX(addr);
+        struct tlb_entry *entry = &tlb->entries[index];
+        entry->page = TLB_PAGE_EMPTY;
+        entry->page_if_writable = TLB_PAGE_EMPTY;
