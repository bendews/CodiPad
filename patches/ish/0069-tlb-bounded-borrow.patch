+#ifdef GUEST_ARM64
+          if (tlb->attached == tlb->mmu && tlb->mmu->ops->translate_pointer_borrowed) {
+            // The caller holds the memory read lock. This pointer is valid for
+            // this access, but a newer generation must never be attached to it.
+            uncached = true;
+            __atomic_store_n(&tlb->stale, TLB_STALE, __ATOMIC_SEQ_CST);
             break;
+          }
+#endif
+          // Other MMUs retain their prior bounded behavior until they expose
+          // an equivalent pointer-lifetime contract.
+          gen = __atomic_load_n(&tlb->mmu->changes, __ATOMIC_ACQUIRE);
+          tlb->mem_changes = gen;
+          break;
         }
