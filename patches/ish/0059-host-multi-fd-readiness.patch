+int task_wait_host_fds(struct pollfd *fds, unsigned count, int timeout_ms) {
+    for (unsigned i = 0; i < count; i++)
+        fds[i].revents = 0;
+    size_t slots = (size_t) count + 1;
+    if (slots <= count)
+        return _ENOMEM;
+    struct pollfd *descriptors = calloc(slots, sizeof(*descriptors));
+    if (descriptors == NULL)
+        return _ENOMEM;
+    for (unsigned i = 0; i < count; i++)
+        descriptors[i] = fds[i];
+    int ready = task_poll_host(descriptors, count, timeout_ms);
+    if (ready > 0) {
+        for (unsigned i = 0; i < count; i++)
+            fds[i].revents = descriptors[i].revents;
+    }
+    free(descriptors);
+    return ready;
