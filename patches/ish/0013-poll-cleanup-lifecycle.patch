+#ifdef CODIPAD_PROCESS_TESTING
+// Move a session's progress timestamp back without changing the production
+// timeout. The host regression uses this after the guest enters epoll_wait.
+int codipad_kernel_test_age_context_idle(uint64_t context, uint64_t age_seconds) {
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+        return -1;
+    uint64_t now_ns = (uint64_t) now.tv_sec * 1000000000ULL + (uint64_t) now.tv_nsec;
+    uint64_t age_ns = age_seconds * 1000000000ULL;
+    uint64_t target_ns = now_ns > age_ns ? now_ns - age_ns : 1;
+    int updated = 0;
+    lock(&pids_lock);
+    for (dword_t pid = 1; pid < MAX_PID; pid++) {
+        struct task *task = pid_get_task_zombie(pid);
+        if (task == NULL || task->group == NULL || task->group->fs_context != context)
+            continue;
+        atomic_store_explicit(&task->group->last_progress_ns, target_ns,
+                              memory_order_relaxed);
+        updated = 1;
+    }
+    unlock(&pids_lock);
+    return updated ? 0 : -1;
+}
+
+int codipad_kernel_test_context_exit_started(uint64_t context) {
+    int started = 0;
+    lock(&pids_lock);
+    for (dword_t pid = 1; pid < MAX_PID; pid++) {
+        struct task *task = pid_get_task_zombie(pid);
+        if (task != NULL && task->group != NULL && task->group->fs_context == context &&
+            atomic_load_explicit(&task->exit_started, memory_order_relaxed))
+            started++;
+    }
+    unlock(&pids_lock);
+    return started;
+}
+#endif
